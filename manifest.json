{
  "manifest_version": 3,
  "name": "AI 爆款文案 - 小红书/抖音/SEO一键生成",
  "short_name": "AI文案",
  "version": "1.0.0",
  "description": "选中任意文字，一键生成小红书爆款文案、抖音脚本、SEO文章。AI赋能内容创作，让写文案像喝水一样简单。",
  "permissions": [
    "contextMenus",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.lemonsqueezy.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
